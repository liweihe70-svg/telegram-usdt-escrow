# Copy to .env.mainnet and fill only on this computer. REAL FUNDS: BNB Chain mainnet (56).
# Separate from .env.production (testnet). Use a NEW Telegram bot, not the testnet bot.
PRODUCTION_TELEGRAM_BOT_TOKEN=
# Mainnet RPC that supports eth_getLogs and the "finalized" block tag. Can also be set in the panel.
BNB_RPC_URL=
# Safety limits in USDT. Raise deliberately.
PRODUCTION_MAX_ORDER_USDT=20
PRODUCTION_MAX_CUSTODY_USDT=100
# Fee: minimum USDT and basis points (100 = 1%).
PRODUCTION_FEE_MIN_USDT=1
PRODUCTION_FEE_BPS=100
# Set a cap to "none" (or 0) to switch it off.
# Display name in the welcome card, and an optional support/arbitrator Telegram username (without @).
PRODUCTION_BOT_BRAND=Escrow
PRODUCTION_SUPPORT_USERNAME=
# Language for users and groups that have not chosen one (en or zh). Mainnet defaults to en.
PRODUCTION_DEFAULT_LANGUAGE=en
